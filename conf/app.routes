# ============================================================================
# ChRIS role — the endpoint ChrisConnector posts GovTalk envelopes to.
# Both submit AND delete envelopes go to this same path (connector uses the
# same target for both), so the controller branches on MessageDetails/Function.
# Path must equal backend `chris.baseUrl` + `chris.submit-url`
# (default chris.submit-url = /ChRIS/SDLT/Filing/sync/SDLT).
# ============================================================================
POST        /ChRIS/SDLT/Filing/sync/SDLT          uk.gov.hmrc.stampdutylandtaxstub.controllers.ChrisStubController.submit()

